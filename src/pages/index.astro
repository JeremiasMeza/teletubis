---
import { getCollection, render } from 'astro:content';
import Counter from '../components/Counter.astro';

// Trae todos los archivos .md de la carpeta timeline y los ordena por fecha
const items = await getCollection('timeline');
items.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Resolvemos el render de cada item ANTES del template (evita await dentro del .map() del JSX)
const renderedItems = await Promise.all(
  items.map(async (item) => {
    const { Content } = await render(item);
    return { item, Content };
  })
);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nuestra Historia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Poppins:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <div class="names">
        <span>Jeremias</span>
        <span class="heart">♥</span>
        <span>Isidora</span>
      </div>
      <h1>Nuestra Línea de Tiempo</h1>
      <p class="subtitle">Cada momento que hemos construido juntos</p>
      <Counter />
    </header>

    <main>
      <ol class="timeline">
        {renderedItems.map(({ item, Content }, index) => (
          <li class:list={['timeline-item', index % 2 === 0 ? 'left' : 'right']}>
            <div class="dot">♥</div>
            <div class="card">
              <time datetime={new Date(item.data.date).toISOString()}>
                {new Date(item.data.date).toLocaleDateString('es-ES', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
              {item.data.title && <h2>{item.data.title}</h2>}
              <div class="content">
                <Content />
              </div>
            </div>
          </li>
        ))}
      </ol>
    </main>

    <footer>
      <p>hecho con amor, para siempre. ♡</p>
    </footer>

    <style>
      :root {
        --rosa-suave: #f7e6e8;
        --rosa-medio: #e8b4bc;
        --rosa-fuerte: #d68a9a;
        --dorado: #c9a15a;
        --crema: #fdf8f3;
        --texto: #4a3b3d;
        --texto-suave: #8a7275;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: linear-gradient(180deg, var(--crema) 0%, #fbeff0 100%);
        color: var(--texto);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
      }

      header {
        text-align: center;
        padding: 4rem 1.5rem 2.5rem;
      }

      .names {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        letter-spacing: 0.05em;
        color: var(--rosa-fuerte);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin-bottom: 0.5rem;
      }

      .names .heart {
        color: var(--dorado);
        font-size: 1.1rem;
      }

      header h1 {
        font-family: 'Playfair Display', serif;
        font-style: italic;
        font-weight: 700;
        font-size: clamp(2rem, 5vw, 3rem);
        margin: 0.2rem 0;
        color: var(--texto);
      }

      .subtitle {
        color: var(--texto-suave);
        font-weight: 300;
        margin-top: 0.3rem;
        font-size: 0.95rem;
      }

      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      .timeline {
        position: relative;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      /* línea central */
      .timeline::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(180deg, var(--rosa-medio), var(--dorado));
        transform: translateX(-50%);
      }

      .timeline-item {
        position: relative;
        width: 50%;
        padding: 1.2rem 2.5rem;
      }

      .timeline-item.left {
        left: 0;
        text-align: right;
      }

      .timeline-item.right {
        left: 50%;
        text-align: left;
      }

      .dot {
        position: absolute;
        top: 1.6rem;
        width: 2rem;
        height: 2rem;
        background: var(--crema);
        border: 2px solid var(--rosa-fuerte);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--rosa-fuerte);
        font-size: 0.9rem;
        z-index: 2;
      }

      .timeline-item.left .dot {
        right: -1rem;
      }

      .timeline-item.right .dot {
        left: -1rem;
      }

      .card {
        display: inline-block;
        max-width: 100%;
        background: #fff;
        border-radius: 16px;
        padding: 1.2rem 1.5rem;
        box-shadow: 0 6px 18px rgba(214, 138, 154, 0.15);
        border: 1px solid var(--rosa-suave);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(214, 138, 154, 0.25);
      }

      .card time {
        display: block;
        font-size: 0.8rem;
        color: var(--dorado);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.4rem;
      }

      .card h2 {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        margin: 0 0 0.5rem;
        color: var(--texto);
      }

      .card .content {
        font-weight: 300;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--texto-suave);
      }

      footer {
        text-align: center;
        padding: 2rem 1rem 3rem;
        color: var(--rosa-fuerte);
        font-family: 'Playfair Display', serif;
        font-style: italic;
      }

      /* Responsive: en mobile todo a un solo lado */
      @media (max-width: 680px) {
        .timeline::before {
          left: 20px;
        }

        .timeline-item,
        .timeline-item.left,
        .timeline-item.right {
          width: 100%;
          left: 0;
          text-align: left;
          padding-left: 3rem;
          padding-right: 1rem;
        }

        .timeline-item.left .dot,
        .timeline-item.right .dot {
          left: 4px;
          right: auto;
        }
      }
    </style>
  </body>
</html>