---
import { getCollection, render } from 'astro:content';
import Counter from '../components/Counter.astro';

// Trae todos los archivos .md de la carpeta timeline y los ordena por fecha
const items = await getCollection('timeline');
items.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nuestra Historia</title>
  </head>
  <body>
    <header>
      <h1>Nuestra Línea de Tiempo</h1>
      <Counter />
    </header>

    <main>
      <h2>Recuerdos</h2>
      <section>
        {items.map(async (item) => {
          // Cambiamos item.render() por render(item)
          const { Content } = await render(item);
          
          return (
            <article style="border: 1px solid #333; margin-bottom: 20px; padding: 15px;">
              <h3>{item.data.title}</h3>
              <small>{new Date(item.data.date).toLocaleDateString()}</small>
              
              {item.data.image && (
                <div style="margin-top: 10px;">
                  <img src={item.data.image} alt={item.data.title} style="max-width: 300px;" />
                </div>
              )}
              
              <div style="margin-top: 10px;">
                <Content />
              </div>
            </article>
          );
        })}
      </section>
    </main>
  </body>
</html>